{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babymemo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "babymemo"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "babymemo-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT",
        "class_name": "WechatSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WechatSession"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 19 * * *"
    ]
  }
}
