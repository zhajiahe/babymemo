{
  "name": "babymemo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-brand-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-offline-shell.mjs",
    "deploy": "npm run build && npm run provision:remote && node scripts/reconcile-birth-time.mjs && node scripts/reconcile-web-management.mjs && wrangler d1 migrations apply DB --remote && wrangler deploy --keep-vars",
    "db:resolve": "node scripts/ensure-d1-id.mjs",
    "test:unit": "node --test scripts/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "check": "tsc --noEmit",
    "deploy:dry-run": "npm run verify && wrangler deploy --dry-run",
    "provision:remote": "node scripts/provision-cloudflare.mjs",
    "smoke:check": "node scripts/smoke-check.mjs",
    "verify": "npm run check && npm run test:unit && npm run build",
    "test:e2e": "node scripts/e2e-local.mjs",
    "test:openrouter:live": "node scripts/openrouter-live-e2e.mjs",
    "test:harness:deep": "node scripts/harness-deep-e2e.mjs",
    "test:harness:live": "node scripts/harness-live-e2e.mjs",
    "test:model:benchmark": "node scripts/model-benchmark.mjs",
    "pretest:unit": "node scripts/build-brand-assets.mjs",
    "prebuild": "node scripts/build-brand-assets.mjs"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 database for family and baby records"
      },
      "MEDIA": {
        "description": "Private R2 media storage"
      },
      "SESSION_SECRET": {
        "description": "Stable session signing secret; do not rotate casually"
      },
      "DATA_KEY": {
        "description": "Stable 32-byte hex encryption key for OpenRouter and WeChat credentials"
      }
    }
  },
  "dependencies": {
    "exifr": "7.1.3",
    "hono": "^4.10.0",
    "json-bigint": "^1.0.0",
    "lucide-react": "^0.555.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "wrangler": "^4.100.0"
  },
  "overrides": {
    "rollup": "4.64.5"
  }
}
